# Optional overrides for backend/src/config.ts
# Copy to .env and customize for local development.

# Optional: force a specific FireFly CLI binary name
# FF_CLI=firefly

FIREFLY_HOST=http://localhost:8000
FIREFLY_NAMESPACE=default
CONTRACT_VERSION=1.2
PORT=4001

# Secrets (prefer env vars over config.json in real deployments)
ADMIN_PASSWORD=blockbuster

# Optional: override addresses without editing config.json
# MOVIE_RATINGS_ADDRESS=
# USER_REGISTRY_ADDRESS=
# ADMIN_ADDRESS=
